---
import Icon from "./Icon.astro";
import ExternalLink from "./ExternalLink.astro";
import type { Project } from "../data/content";

interface Props {
  project: Project;
  headingLevel?: "h2" | "h3";
}
const { project, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<article class:list={["card reveal flex flex-col p-4 sm:p-5", project.featured && "card-featured sm:p-6"]}>
  <p class="mb-2 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-muted">
    {project.featured && <span class="badge">Featured</span>}
    {project.dates}
  </p>
  <Heading class:list={["font-semibold tracking-tight text-ink", project.featured ? "text-xl" : "text-lg"]}>
    {project.title}
  </Heading>
  <p class="mt-2 text-muted">{project.description}</p>

  {
    project.stats && (
      <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 border-y border-line py-4 sm:grid-cols-4">
        {project.stats.map((s) => (
          <div class="flex flex-col-reverse">
            <dt class="font-mono text-xs text-muted">{s.label}</dt>
            <dd class="font-mono text-base font-medium text-accent">{s.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="bullets mt-4 space-y-2 text-[0.95rem]">
    {project.bullets.map((b) => <li>{b}</li>)}
  </ul>

  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
    {project.tags.map((t) => <li class="tag">{t}</li>)}
  </ul>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-line pt-4">
    <p class="font-mono text-xs text-muted">
      {
        project.meta.map((m, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <span class="sm:whitespace-nowrap">{m}</span>
          </>
        ))
      }
    </p>
    <div class="flex gap-2">
      {
        project.links.map((l) => (
          <ExternalLink
            href={l.href}
            class="btn btn-sm"
            aria-label={`${project.title} ${l.label === "Live" ? "live site" : "on GitHub"} (opens in a new tab)`}
          >
            {l.label === "GitHub" ? <Icon name="github" size={14} /> : <Icon name="external" size={14} />}
            {l.label}
          </ExternalLink>
        ))
      }
    </div>
  </div>
</article>
