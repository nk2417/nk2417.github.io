---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Page not found" description="This page doesn't exist.">
  <section class="flex min-h-[calc(100dvh-14rem)] flex-col justify-center py-16">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Page not found</h1>
    <p class="mt-2 text-base text-muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8">
      <a href="/" class="btn btn-primary">Back to Home <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Layout>
