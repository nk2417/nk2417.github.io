---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { about, aboutPhotos, currently, subtitles } from "../data/content";

const hasHeadshot = fs.existsSync(path.join(process.cwd(), "public", "headshot.jpg"));

const photos = aboutPhotos.filter((p) => fs.existsSync(path.join(process.cwd(), "public", "about", p.file)));

const { squat, golf, running, song } = currently;
const nextRace = running.races.findIndex((r) => !r.done);
const squatPct = Math.min(100, Math.round((squat.current / squat.goal) * 100));
---

<Layout
  title="About"
  description="About Hansung Noah Kang, a Boston College Computer Science graduate with a minor in Finance, based in the NYC metro area."
>
  <header class="pt-10 pb-6 sm:pt-12">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">About</h1>
    <p class="mt-2 text-base text-muted">{subtitles.about}</p>
  </header>

  <div class:list={["reveal", hasHeadshot && "grid gap-6 sm:grid-cols-[200px_1fr] sm:gap-8"]}>
    {
      hasHeadshot && (
        <div class="sm:relative">
          <img
            src="/headshot.jpg"
            alt={about.headshotAlt}
            width="720"
            height="720"
            fetchpriority="high"
            class="aspect-square w-44 rounded-[10px] border border-line object-cover object-top sm:absolute sm:inset-0 sm:aspect-auto sm:h-full sm:w-full"
          />
        </div>
      )
    }
    <div class="space-y-4 text-ink/90">
      <p class="text-xl font-semibold tracking-tight text-ink">{about.greeting}</p>
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <section aria-labelledby="currently-heading" class="mt-12">
    <h2 id="currently-heading" class="mb-3 font-mono text-xs uppercase tracking-wider text-muted">Currently</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="card reveal p-4 sm:col-span-2 sm:p-5">
        <div class="flex items-baseline justify-between gap-4">
          <p class="font-mono text-xs text-muted">{squat.label} {squat.goal}</p>
          <p class="font-mono text-sm text-muted">
            <span class="font-medium text-accent">{squat.current}</span> / {squat.goal}
          </p>
        </div>
        <div
          class="progress mt-3"
          role="progressbar"
          aria-label={`Squat progress: ${squat.current} of ${squat.goal} pounds`}
          aria-valuemin="0"
          aria-valuemax={squat.goal}
          aria-valuenow={squat.current}
        >
          <div class="progress-fill" style={`--pct: ${squatPct}%`}></div>
        </div>
        <p class="mt-2 font-mono text-xs text-muted">{squatPct}%</p>
      </div>

      <div class="card reveal p-4 sm:p-5">
        <p class="font-mono text-xs text-muted">{golf.label}</p>
        <dl class="mt-3 grid grid-cols-3 gap-3">
          {
            golf.items.map((part) => {
              const [name, value] = part.split(": ");
              return (
                <div class="flex flex-col-reverse">
                  <dt class="mt-0.5 font-mono text-xs text-muted">{name}</dt>
                  <dd class="text-[0.95rem] font-medium text-ink">{value}</dd>
                </div>
              );
            })
          }
        </dl>
      </div>

      <div class="card reveal p-4 sm:p-5">
        <p class="font-mono text-xs text-muted">{running.label}</p>
        <ul class="mt-3 space-y-2 text-[0.95rem]">
          {
            running.races.map((race, i) => {
              const isNext = !race.done && i === nextRace;
              return (
                <li class="flex items-center gap-2.5">
                  {race.done ? (
                    <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-accent text-on-accent">
                      <Icon name="check" size={11} />
                    </span>
                  ) : (
                    <span class="size-4 shrink-0 rounded-full border-[1.5px] border-dashed border-muted" aria-hidden="true" />
                  )}
                  <span class:list={["font-medium", race.done ? "text-ink" : "text-ink/80"]}>{race.name}</span>
                  <span class="ml-auto font-mono text-xs text-muted">
                    {race.done ? "Done" : isNext ? <span class="text-accent">Next</span> : "Planned"}
                  </span>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="card reveal p-4 sm:col-span-2 sm:p-5">
        <p class="mb-3 font-mono text-xs text-muted">{song.label}</p>
        <iframe
          data-src={song.embedUrl}
          title={`Spotify player: ${song.title} by ${song.artist}`}
          width="100%"
          height="152"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          class="block w-full rounded-[12px] border-0 bg-surface"
          style="color-scheme: normal"></iframe>
        <noscript>
          <a class="link" href={song.embedUrl.replace("/embed", "").split("?")[0]} target="_blank" rel="noopener noreferrer">
            {song.title} by {song.artist} on Spotify
          </a>
        </noscript>
      </div>
    </div>
  </section>

  {
    photos.length > 0 && (
      <section aria-label="Photos" class="reveal mt-12">
        <ul class="photo-strip -mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0">
          {photos.map((photo) => (
            <li class="w-[62%] shrink-0 snap-center sm:w-auto">
              <figure>
                <div class="photo-frame aspect-[4/5] overflow-hidden rounded-[10px] border border-line">
                  <img
                    src={`/about/${photo.file}`}
                    alt={photo.alt}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                    style={`object-position: ${photo.focus}; transform-origin: ${photo.focus}; --zoom: ${photo.zoom}`}
                  />
                </div>
                <figcaption class="mt-2 font-mono text-xs text-muted">{photo.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="h-16"></div>
</Layout>
